// Experiment 3: Product Class with Array of Objects

#include <iostream>
#include <string>
#include <iomanip>
using namespace std;

class Product {
private:
    int productId;
    string productName;
    float price;
    int monthlySales[12];
    int totalQuantity;
    float totalBill;
    float discount;
    float finalBill;

public:
    // Constructor
    Product() {
        productId = 0;
        price = 0;
        totalQuantity = 0;
        totalBill = 0;
        discount = 0;
        finalBill = 0;

        for (int i = 0; i < 12; i++)
            monthlySales[i] = 0;
    }

    // Accept product details
    void acceptDetails() {
        cout << "Enter Product ID: ";
        cin >> productId;
        cin.ignore();

        cout << "Enter Product Name: ";
        getline(cin, productName);

        cout << "Enter Price per Unit: ";
        cin >> price;

        while (price <= 0) {
            cout << "Price must be greater than 0. Enter again: ";
            cin >> price;
        }

        cout << "Enter sales for 12 months:\n";
        totalQuantity = 0;

        for (int i = 0; i < 12; i++) {
            cout << "Month " << i + 1 << ": ";
            cin >> monthlySales[i];

            while (monthlySales[i] < 0) {
                cout << "Sales cannot be negative. Enter again: ";
                cin >> monthlySales[i];
            }

            totalQuantity += monthlySales[i];
        }

        // Calculate total bill
        totalBill = totalQuantity * price;

        // Apply 10% discount if bill is above 50,000
        if (totalBill >= 50000)
            discount = totalBill * 0.10;
        else
            discount = 0;

        finalBill = totalBill - discount;
    }

    // Display product details
    void displayDetails() {
        cout << "\n-----------------------------------\n";
        cout << "Product ID       : " << productId << endl;
        cout << "Product Name     : " << productName << endl;
        cout << "Price per Unit   : " << fixed << setprecision(2)
             << price << endl;

        cout << "\nMonthly Sales:\n";

        for (int i = 0; i < 12; i++) {
            cout << "Month " << i + 1 << " : "
                 << monthlySales[i] << endl;
        }

        cout << "\nTotal Quantity   : " << totalQuantity << endl;
        cout << "Total Bill       : Rs. " << totalBill << endl;
        cout << "Discount         : Rs. " << discount << endl;
        cout << "Final Bill       : Rs. " << finalBill << endl;
        cout << "-----------------------------------\n";
    }

    // Return final bill
    float getFinalBill() const {
        return finalBill;
    }

    // Return total quantity
    int getTotalQuantity() const {
        return totalQuantity;
    }
};

int main() {
    int n;

    cout << "Enter number of products (maximum 100): ";
    cin >> n;

    // Validate number of products
    while (n <= 0 || n > 100) {
        cout << "Invalid number! Enter between 1 and 100: ";
        cin >> n;
    }

    Product products[100];

    float grandTotal = 0;
    int highestQuantity = 0;
    int bestProduct = 0;

    // Accept details of all products
    for (int i = 0; i < n; i++) {
        cout << "\n===== Product " << i + 1 << " =====\n";

        products[i].acceptDetails();

        grandTotal += products[i].getFinalBill();

        // Find highest-selling product
        if (products[i].getTotalQuantity() > highestQuantity) {
            highestQuantity = products[i].getTotalQuantity();
            bestProduct = i;
        }
    }

    // Display all products
    cout << "\n\n========== ALL PRODUCT DETAILS ==========\n";

    for (int i = 0; i < n; i++) {
        products[i].displayDetails();
    }

    cout << "\n=========================================\n";
    cout << "Grand Total Bill : Rs. "
         << fixed << setprecision(2) << grandTotal << endl;

    cout << "Highest Selling Product Details:\n";
    products[bestProduct].displayDetails();

    cout << "=========================================\n";

    return 0;
}
