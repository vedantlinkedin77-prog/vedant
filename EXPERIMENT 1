// Student Class with Details, Result and Grade Calculation

#include <iostream>
#include <string>
#include <iomanip>
using namespace std;

class Student {
private:
    int rollNumber;
    string name;
    string subjects[3] = {"Mathematics", "Physics", "Computer"};
    float marks[3];
    float total;
    float percentage;
    string result;
    char grade;

public:

    // Function to accept student details
    void acceptDetails() {
        cout << "Enter Roll Number: ";
        cin >> rollNumber;

        cin.ignore();
        cout << "Enter Student Name: ";
        getline(cin, name);

        cout << "\nEnter marks out of 100:\n";

        for (int i = 0; i < 3; i++) {
            cout << subjects[i] << ": ";
            cin >> marks[i];

            // Validate marks
            while (marks[i] < 0 || marks[i] > 100) {
                cout << "Invalid marks! Enter marks between 0 and 100: ";
                cin >> marks[i];
            }
        }
    }

    // Function to calculate result
    void calculateResult() {
        total = 0;

        for (int i = 0; i < 3; i++) {
            total += marks[i];
        }

        percentage = total / 3.0;

        // Calculate class
        if (percentage >= 60)
            result = "First Class";
        else if (percentage >= 50)
            result = "Second Class";
        else if (percentage >= 40)
            result = "Pass";
        else
            result = "Fail";

        // Calculate grade
        if (percentage >= 90)
            grade = 'A';
        else if (percentage >= 80)
            grade = 'B';
        else if (percentage >= 70)
            grade = 'C';
        else if (percentage >= 60)
            grade = 'D';
        else if (percentage >= 40)
            grade = 'E';
        else
            grade = 'F';
    }

    // Function to display student details
    void displayDetails() {
        cout << "\n====================================\n";
        cout << "          STUDENT REPORT CARD       \n";
        cout << "====================================\n";

        cout << "Roll Number : " << rollNumber << endl;
        cout << "Name        : " << name << endl;

        cout << "\nSubject-wise Marks:\n";

        for (int i = 0; i < 3; i++) {
            cout << left << setw(15) << subjects[i]
                 << ": " << marks[i] << endl;
        }

        cout << "\nTotal Marks : " << total << " / 300" << endl;
        cout << fixed << setprecision(2);
        cout << "Percentage  : " << percentage << "%" << endl;
        cout << "Grade       : " << grade << endl;
        cout << "Result      : " << result << endl;

        cout << "====================================\n";
    }
};

int main() {

    Student s;

    s.acceptDetails();
    s.calculateResult();
    s.displayDetails();

    return 0;
}
